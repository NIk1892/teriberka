# Боевой конфиг nginx: то же, что в ../templates/default.conf.template, плюс TLS.
# Подключается прод-оверлеем (docker-compose.prod.yml), локальная разработка
# продолжает работать по http со старым шаблоном.
#
#   :80  -> редирект на https (кроме ACME-проверки)
#   :443 -> /media/* в MinIO, всё остальное в ui-public
#
# Сертификат монтируется из ${CERT_DIR} снаружи репозитория в /etc/nginx/certs
# под ФИКСИРОВАННЫМИ именами. Имена намеренно без домена: ${SITE_DOMAIN} может
# содержать два имени через пробел (apex и www), и путь с пробелом внутри не дал
# бы nginx стартовать.
#
# Файл включается внутрь http{}, поэтому limit_req_zone здесь допустим.

limit_req_zone $binary_remote_addr zone=media:10m rate=30r/s;

# ---------- http: только редирект и ACME ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN};

    server_tokens off;

    # Проверка владения доменом. Сертификат сейчас коммерческий (reg.ru) и
    # проверки не требует, но location оставлен: переход на Let's Encrypt не
    # должен требовать правки конфига. Стоит ВЫШЕ редиректа — ACME ходит по http.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Жёстко на канонический хост, а не на $host: заодно уводит www на apex,
    # и посетитель не получает два редиректа подряд.
    location / {
        return 301 https://${SITE_HOST}$request_uri;
    }
}

# ---------- https: сам сайт ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # Наборы шифров TLS 1.3 выбирает клиент — навязывать серверный порядок
    # современным браузерам смысла нет.
    ssl_prefer_server_ciphers off;

    # HSTS живёт ТОЛЬКО в этом блоке: на http его слать бессмысленно, а на
    # localhost он заставил бы браузер запомнить localhost как https-only и
    # сломал бы прочие локальные проекты.
    # ВНИМАНИЕ: начинаем с короткого срока. Пока max-age маленький, ошибку в
    # сертификате ещё можно откатить; после нескольких дней стабильной работы
    # поднять до 31536000. includeSubDomains не ставим — поддоменов нет, а
    # отозвать это обещание нельзя.
    add_header Strict-Transport-Security "max-age=300" always;

    # Встроенный DNS docker. Нужен потому, что в proxy_pass медиа есть переменная
    # ($obj) — из-за неё nginx резолвит имя upstream'а не на старте, а на каждом
    # запросе, и без resolver отвечает 502 «no resolver defined to resolve minio».
    resolver 127.0.0.11 valid=30s ipv6=off;

    server_tokens off;
    client_max_body_size 128k;

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml;

    # server_name принимает и www, если он есть в сертификате. Отправляем на
    # канонический адрес, чтобы у страницы был один URL (canonical в разметке
    # тоже указывает на apex). Единственный безопасный вид if — только return.
    if ($host != "${SITE_HOST}") {
        return 301 https://${SITE_HOST}$request_uri;
    }

    # ---------- фото из хранилища ----------
    # Регулярка — это и есть защита: наружу проходит ровно один сценарий, чтение
    # готового .webp. Перечисление бакета (/media/?list-type=2), .svg, .html и
    # любые подписанные ссылки в этот location не попадают и получают 404.
    location ~* ^/media/(?<obj>.+\.webp)$ {
        limit_except GET HEAD { deny all; }
        limit_req zone=media burst=60 nodelay;

        # "?" в конце отбрасывает query — до MinIO она не доходит.
        proxy_pass http://minio:9000/${MEDIA_BUCKET}/$obj?;
        proxy_http_version 1.1;
        proxy_set_header Host minio:9000;
        proxy_hide_header Server;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-minio-deployment-id;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Content-Type;

        # always — иначе заголовки не попадут в ответы 404/503. add_header внутри
        # location отменяет унаследованные из server, поэтому HSTS повторяется.
        add_header Strict-Transport-Security "max-age=300" always;
        add_header Content-Type "image/webp" always;
        add_header Cache-Control "public, max-age=${MEDIA_MAX_AGE}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # ---------- всё остальное — сайт ----------
    location / {
        proxy_pass http://ui-public:8080;
        proxy_http_version 1.1;

        # В Production ASP.NET сам добавляет HSTS (UseHsts, 30 дней), и заголовок
        # приходил бы дважды — с разным сроком. Прячем чужой: HSTS в этом проекте
        # живёт только здесь, иначе срок пришлось бы менять в двух местах, а для
        # /media (nginx → MinIO) его бы не было вовсе.
        proxy_hide_header Strict-Transport-Security;

        # ОБЯЗАТЕЛЬНО: nginx не ставит эти заголовки сам. Без них
        # USE_FORWARDED_HEADERS у UI бесполезен — Kestrel увидит адрес контейнера
        # nginx, один на всех посетителей, и rate limiter превратится в общий
        # счётчик. X-Forwarded-Proto заодно включает флаг Secure у cookie.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
