@using UI.Public.Web.Features.Errors.Pages
@using UI.Public.Web.Layouts

<Router AppAssembly="@typeof(Routes).Assembly" NotFoundPage="typeof(NotFoundView)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
