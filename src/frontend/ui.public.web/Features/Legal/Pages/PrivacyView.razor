@page "/privacy"
@using Microsoft.Extensions.Localization
@using UI.Public.Web.Layouts
@layout MainLayout
@inject IStringLocalizer<SharedResource> L
@inject IConfiguration Configuration

@* Черновик политики конфиденциальности — плейсхолдер: перед запуском текст
   заменить на настоящий (см. PrivacyDraftNote); реквизиты оператора
   уже настоящие — они общие с футером, ключ FooterLegal. *@

<PageTitle>@L["PrivacyTitle"] · @L["Brand"]</PageTitle>
<PageMeta Title="@L["PrivacyTitle"]" Description="@L["PrivacyLead"]" Path="/privacy" />

<section class="section">
    <div class="container detail legal">
        <h1>@L["PrivacyTitle"]</h1>
        <p class="detail-lead">@L["PrivacyLead"]</p>
        <p class="legal-draft">@L["PrivacyDraftNote"]</p>

        <h2>@L["PrivacyS1Title"]</h2>
        <p>@L["PrivacyS1Text"]</p>

        <h2>@L["PrivacyS2Title"]</h2>
        <p>@L["PrivacyS2Text"]</p>

        <h2>@L["PrivacyS3Title"]</h2>
        <p>@L["PrivacyS3Text"]</p>

        <h2>@L["PrivacyS4Title"]</h2>
        <p>@L["PrivacyS4Text"]</p>

        @* Согласие на публикацию отзывов и фото гостей (владелец, 28.08.2026) —
           появилось вместе с блоком отзывов и фотолентой на главной. *@
        <h2>@L["PrivacyS5Title"]</h2>
        <p>@L["PrivacyS5Text"]</p>

        @* Почта — из CONTACT_EMAIL, как контакты футера: пустой ключ прячет
           ссылку, значение не дублируется в resx. *@
        <p class="legal-operator">
            @L["FooterLegal"]@if (!string.IsNullOrWhiteSpace(Email))
            {<text> · </text><a href="mailto:@Email">@Email</a>}
        </p>

        <p><a class="back-link" href="/">@L["BackToHome"]</a></p>
    </div>
</section>

@code {
    private string? Email => Configuration["CONTACT_EMAIL"];
}
