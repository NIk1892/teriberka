@page "/not-found"
@using Microsoft.Extensions.Localization
@using UI.Public.Web.Layouts
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFoundTitle"] · @L["Brand"]</PageTitle>

<section class="section">
    <div class="container detail">
        <h1>@L["NotFoundTitle"]</h1>
        <p class="detail-lead">@L["NotFoundText"]</p>
        <p><a class="back-link" href="/">@L["BackToHome"]</a></p>
    </div>
</section>
