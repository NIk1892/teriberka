@page "/not-found"
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@using UI.Public.Web.Layouts
@layout MainLayout
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<PageTitle>@L["NotFoundTitle"] · @L["Brand"]</PageTitle>
<PageMeta Noindex />

<section class="section">
    <div class="container detail">
        <h1>@L["NotFoundTitle"]</h1>
        <p class="detail-lead">@L["NotFoundText"]</p>
        <p><a class="back-link" href="/">@L["BackToHome"]</a></p>
    </div>
</section>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Честный 404 и при прямом заходе на /not-found, а не только когда сюда
        // перенаправил роутер: «мягкая» страница с кодом 200 индексируется.
        // Именно Navigation.NotFound(), а не ручной Response.StatusCode: при ручной
        // установке кода static SSR отдаёт 404 с пустым телом (проверено на .NET 10).
        if (HttpContext is not null && HttpContext.Response.StatusCode != StatusCodes.Status404NotFound)
            Navigation.NotFound();
    }
}
