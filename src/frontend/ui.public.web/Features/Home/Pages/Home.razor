@page "/"
@using UI.Public.Web.Layouts
@using UI.Public.Web.Features.Home
@using UI.Public.Web.Features.Places
@using UI.Public.Web.Features.Seo
@using UI.Public.Web.Features.Chat
@using UI.Public.Web.Components
@using Microsoft.Extensions.Localization
@layout MainLayout
@inject IStringLocalizer<SharedResource> L
@inject SeoUrls Seo
@inject IConfiguration Configuration
@inject IWebHostEnvironment Env

<PageTitle>@L["PageTitle"]</PageTitle>
<PageMeta Title="@L["PageTitle"]" Description="@L["MetaDescription"]" Path="/" />
@* Как в ManagerLayout: отдельный HeadContent вытеснил бы SEO из PageMeta. *@
<link rel="stylesheet" href="@Assets["css/home.css"]" />

<div class="home-page">
<NightSky />

@* Воронка главной: витрина и день в Териберке → кнопка заявки с ценой → что
   входит в цену → другие маршруты Кольского → форма → «почему с нами» и FAQ
   для сомневающихся (владелец, 25.08.2026). *@

@* На телефоне: короткое вступление → фотографии → интерактивная карта.
   Карта без transform-параллакса: её fixed-оверлей закрытия остаётся относительно окна. *@
<section class="hero" id="directions">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="hero-kicker">@L["HeroKicker"]</span>
            <h1>
                @L["HeroTitle"]
                <span class="hero-title-sub">@L["HeroTitleSub"]</span>
            </h1>
            <div class="hero-postcards">
                <div class="hero-postcard-main hero-carousel carousel-wrap" data-autoplay="4000" role="region" aria-label="@L["HomePhotoNote"]">
                    <div class="hero-carousel-track carousel-track" id="hero-photo-track" tabindex="0" aria-label="@L["HomePhotoNote"]">
                        @for (var i = 0; i < IntroSlides.Length; i++)
                        {
                            var slide = IntroSlides[i];
                            <a class="hero-carousel-slide lightbox-link" href="@Asset(slide.ImagePath)" target="_blank" rel="noopener">
                                <img src="@Asset(slide.ImagePath)" srcset="@SrcSet(slide.ImagePath, 1500)"
                                     sizes="@HeroPhotoSizes" alt="@L[slide.AltKey]" width="1500" height="1200"
                                     loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")"
                                     decoding="async" draggable="false" />
                            </a>
                        }
                    </div>
                </div>
                <a class="hero-postcard-detail lightbox-link" href="@Asset("/img/hero-urchin.webp")" target="_blank" rel="noopener">
                    <img src="@Asset("/img/hero-urchin.webp")" srcset="@SrcSet("/img/hero-urchin.webp", 1200)"
                         sizes="(min-width: 960px) 160px, 120px" alt="@L["HeroSlide8Alt"]" width="1200" height="1500" decoding="async" />
                </a>
                <span class="hero-photo-note">@L["HomePhotoNote"]</span>
            </div>
            <ul class="hero-trip-facts">
                <li><strong>@L["HomeDurationValue"]</strong><span>@L["HomeDurationLabel"]</span></li>
                <li><strong>@L["HomeGroupValue"]</strong><span>@L["HomeGroupLabel"]</span></li>
                <li><strong>@L["HomeDepartureValue"]</strong><span>@L["HomeDepartureLabel"]</span></li>
            </ul>
        </div>

        <div class="hero-visual">
            <div class="hero-map">
                <div class="home-map-heading">
                    <h2>@L["HomeMapTitle"]</h2>
                </div>
                <KolaMap />
                <p class="map-hint">@L["MapHint"]</p>
            </div>
        </div>

        <div class="home-trip-intro">
            <ul class="hero-facts">
                @foreach (var i in Enumerable.Range(1, 5))
                {
                    <li>@L[$"HeroFact{i}"]</li>
                }
            </ul>
        </div>

        @* Карточки мест Териберки. id=places — якорь шапки. *@
        <section class="hero-places" id="places">
            <div class="section-head">
                <span class="home-eyebrow">@L["HomePlacesKicker"]</span>
                <h2>@L["PlacesTitle"]</h2>
                <p>@L["PlacesSubtitle"]</p>
                @* Ссылка «(Смотрите больше фото и видео в галерее)» стояла здесь и
                   временно убрана владельцем 25.08.2026: раздел «Галерея» пока
                   заглушка «скоро», вести туда не с чего. Ключ PlacesGalleryLink,
                   стили .places-more и скобки в разметке сохранены — возвращается
                   одной строкой:
                   <p class="places-more">(<a href="/gallery">@L["PlacesGalleryLink"]</a>)</p> *@
            </div>
            @* На ≤560px сетка становится каруселью по одной карточке во всю ширину
               (владелец, 24.08.2026: «половинка» соседней карточки читалась как обрез);
               стрелки — carousel.js, на широких экранах скрыты, там обычная сетка. *@
            <div class="places-carousel carousel-wrap">
            <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
            @* Карточки — список SeeCards ниже, а не места каталога один к одному
               (владелец, 16.09.2026): две карточки объединяют по два места, а у морской
               прогулки и фототочек Старой Териберки своих страниц нет — они ведут на шаг
               программы дня. На телефоне показываем один полный кадр за раз. *@
            <div class="places-grid see-grid carousel-track">
                @foreach (var card in SeeCards)
                {
                    <a class="place-card" href="@card.Href">
                        <span class="place-photo">
                            <img src="@Asset(card.Photo)" srcset="@SrcSet(card.Photo, 1280)"
                                 sizes="@(card.Key == "See1" ? SeeFeaturedPhotoSizes : SeePhotoSizes)" alt="@L[$"{card.Key}Title"]" loading="lazy" decoding="async" />
                        </span>
                        <span class="place-body">
                            <strong class="place-title">@L[$"{card.Key}Title"]</strong>
                            <span class="place-text">@L[$"{card.Key}Text"]</span>
                            <span class="place-more">@L["PlaceMore"]</span>
                        </span>
                    </a>
                }
            </div>
            <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
            </div>
            <p class="home-swipe-hint"><span aria-hidden="true">↔</span> @L["HomeSwipeHint"]</p>
        </section>
    </div>
</section>

<section class="section itinerary" id="itinerary">
    <div class="container">
        <div class="section-head">
            <h2>@L["ItineraryTitle"]</h2>
            <p>@L["ItinerarySubtitle"]</p>
        </div>
        @* Маршрут дня (владелец, 25.08.2026 — вместо сетки текстовых карточек):
           вертикальная пунктирная нить, как маршруты на карте Кольского, на ней
           точки-номера, у каждой остановки карточка с фото и описанием. Восемь
           шагов с 16.09.2026 (программа владельца: встреча → дорога → дегустация →
           морская прогулка → Старая Териберка → обед → природный парк → возвращение).
           Фото — кадры владельца из src/frontend/temp (список RoutePhotos ниже);
           у остановки с несколькими кадрами — карусель carousel.js (тот же
           .carousel-wrap: свайп без JS, стрелки с ним). Новый кадр: файл в
           wwwroot/img/itinerary/ и имя в RoutePhotos; новый шаг — ещё и ключи
           Itinerary{i}Title/Text в трёх resx. Миниатюры мест у шагов
           убирались 24.08.2026 — то были мелкие ссылки, спорившие с текстом;
           здесь фото — часть самой карточки, без ссылок. *@
        <ol class="itinerary-route">
            @foreach (var i in Enumerable.Range(1, RoutePhotos.Length))
            {
                var photos = RoutePhotos[i - 1];
                <li class="route-stop" id="stop-@i">
                    <span class="route-stop-marker" aria-hidden="true">0@(i)</span>
                    <article class="route-stop-card">
                        @if (photos.Length > 1)
                        {
                            @* data-autoplay — автопрокрут carousel.js по правилам проекта
                               (пауза вне вьюпорта, в фоновой вкладке и под курсором, ручное
                               листание выключает насовсем, при reduced-motion не стартует).
                               Задержки разведены по остановкам, чтобы карусели не листались
                               синхронно — вместе это читалось бы как один общий таймер.
                               Цикл 5,6–7,7 с по кругу: у соседних остановок задержки всегда
                               разные, а с ростом числа шагов лента не замедляется. *@
                            <div class="route-photo-carousel carousel-wrap" data-autoplay="@(5600 + i % 4 * 700)">
                                <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
                                <div class="route-photo-track carousel-track">
                                    @for (var n = 0; n < photos.Length; n++)
                                    {
                                        <span class="route-stop-photo">
                                            <img src="@Asset($"/img/itinerary/{photos[n]}")" srcset="@SrcSet($"/img/itinerary/{photos[n]}", 1000)"
                                                 sizes="@RouteSizes" alt="@(n == 0 ? L[$"Itinerary{i}Title"].Value : "")"
                                                 loading="lazy" decoding="async" />
                                        </span>
                                    }
                                </div>
                                <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
                            </div>
                        }
                        else
                        {
                            <span class="route-stop-photo">
                                <img src="@Asset($"/img/itinerary/{photos[0]}")" srcset="@SrcSet($"/img/itinerary/{photos[0]}", 1000)"
                                     sizes="@RouteSizes" alt="@L[$"Itinerary{i}Title"]" loading="lazy" decoding="async" />
                            </span>
                        }
                        <div class="route-stop-body">
                            <strong>@L[$"Itinerary{i}Title"]</strong>
                            <p>@L[$"Itinerary{i}Text"]</p>
                        </div>
                    </article>
                </li>
            }
        </ol>
        <p class="itinerary-note">@L["ItineraryNote"]</p>

        @* Кнопка с ценой под программой дня (владелец, 25.08.2026): форма стоит
           в конце страницы, сюда возвращается только призыв. Ghost-кнопки
           «Программа дня» рядом нет — она вела бы в блок, который прямо над ней
           (ключ HeroCta2 в resx остался). До этого места кнопку заявки держит
           шапка: .nav-apply на десктопе и .header-apply на мобиле. *@
        <div class="tour-cta">
            <div class="hero-actions">
                <a class="btn btn-pulse" href="#apply">@L["HeroCta"]</a>
            </div>
            @* Строка «Заявка без предоплаты и обязательств» (.hero-trust, ключ
               HeroTrust) убрана владельцем 25.08.2026 — ключ и стиль сохранены.
               То же обещание осталось прозой в подводке формы и в «почему с нами». *@
            <p class="hero-meta">
                <strong class="hero-price">@L["HeroPrice"]</strong>
                <span class="hero-note">@L["HeroNote"]</span>
            </p>
        </div>
    </div>
</section>

@* «Что включено» стоит сразу за строкой цены под маршрутом (владелец, 25.08.2026):
   это состав оффера — ответ на «что я получу за эти деньги», а не работа с
   сомнениями. Отработка возражений («почему с нами», FAQ) идёт после формы. *@
<section class="section home-included" id="included">
    <div class="container">
        <div class="section-head">
            <h2>@L["IncludedTitle"]</h2>
            <p>@L["IncludedSubtitle"]</p>
        </div>
        <div class="home-included-layout">
        <div class="home-included-photos">
            <span class="home-included-photo">
            <img src="@Asset("/img/itinerary/tasting-urchins.webp")" srcset="@SrcSet("/img/itinerary/tasting-urchins.webp", 1000)"
                 sizes="@IncludedPhotoSizes" alt="@L["Itinerary3Title"]" width="1000" height="625" loading="lazy" decoding="async" />
            </span>
            <span class="home-included-photo">
            <img src="@Asset("/img/itinerary/sea-helm.webp")" srcset="@SrcSet("/img/itinerary/sea-helm.webp", 1000)"
                 sizes="@IncludedPhotoSizes" alt="@L["Itinerary4Title"]" width="1000" height="625" loading="lazy" decoding="async" />
            </span>
        </div>
        <ul class="included-grid">
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <li>@L[$"Included{i}"]</li>
            }
        </ul>
        </div>
    </div>
</section>

@* Фотопауза между Териберкой и остальными маршрутами. Кадр владельца: temp/IMG_6691.HEIC,
   адаптивная загрузка без тяжёлого видео или fixed-фона на телефоне. *@
<aside class="home-sea-moment">
    <img src="@Asset("/img/home-sea-panorama.webp")" srcset="@SrcSet("/img/home-sea-panorama.webp", 1920)"
         sizes="@SeaPhotoSizes" alt="@L["HomeSeaPhotoAlt"]" width="1920" height="1080" loading="lazy" decoding="async" />
    <div class="container">
        <span class="home-eyebrow">@L["HomeSeaKicker"]</span>
        <p>@L["Band1Text"]</p>
    </div>
</aside>

<section class="route-picker more-routes" id="more-routes" aria-labelledby="other-routes-title">
    <div class="container">
        <div class="route-picker-head">
            @* Кикер «Не только Териберка» убран владельцем 25.08.2026 — заголовок
               «Другие маршруты» и так говорит всё. Ключ OtherRoutesKicker в resx
               остался, стиль .route-picker-head > span тоже. *@
            <h2 id="other-routes-title">@L["OtherRoutesTitle"]</h2>
            <p>@L["OtherRoutesText"]</p>
        </div>

        @foreach (var dir in PlaceCatalog.Directions.Skip(1))
        {
            <div class="direction-block" id="dir-@dir.Key">
                <div class="direction-head">
                    <span class="direction-num" aria-hidden="true">0@(dir.Index)</span>
                    <div>
                        <span class="alt-route-type">@L[$"OtherRoute{dir.Index}Type"]</span>
                        <h3>@L[$"Dir{dir.Index}Title"]</h3>
                        <p>@L[$"Dir{dir.Index}Text"]</p>
                    </div>
                </div>
                @* меньше трёх карточек — двухколоночная сетка (в трёх колонках пусто), иначе обычные три *@
                <div class="places-carousel carousel-wrap">
                <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
                <div class="places-grid carousel-track @(dir.PlaceIndexes.Length < 3 ? "cols-2" : "")">
                    @foreach (var idx in dir.PlaceIndexes)
                    {
                        var place = PlaceCatalog.ByIndex(idx);
                        <a class="place-card" href="/place/@place.Slug">
                            <span class="place-photo">
                                <img src="@Asset($"/img/places/{place.Slug}.webp")" srcset="@SrcSet($"/img/places/{place.Slug}.webp", 1280)"
                                     sizes="@PlaceSizes(twoCols: dir.PlaceIndexes.Length < 3)" alt="@L[$"Place{idx}Title"]" loading="lazy" decoding="async" />
                            </span>
                            <span class="place-body">
                                <strong class="place-title">@L[$"Place{idx}Title"]</strong>
                                <span class="place-text">@L[$"Place{idx}Text"]</span>
                                <span class="place-more">@L["PlaceMore"]</span>
                            </span>
                        </a>
                    }
                </div>
                <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
                </div>
            </div>
        }

    </div>
</section>


@* Форма — сразу за блоком «Другие маршруты» (владелец, 25.08.2026): посетитель
   успел увидеть места, прочитать программу дня и посмотреть остальные направления,
   а маршрут выбирает уже в самой форме. Под программой дня стоит только кнопка-якорь,
   ведущая сюда; всё, что ниже формы (почему с нами, что включено, сезоны, FAQ),
   работает на тех, кто ещё сомневается. Форма на странице ровно одна — у static SSR
   FormName уникален, двух ApplicationForm быть не может.
   id="apply" — внутри, на самой форме (ApplicationForm.razor): якорь должен
   приводить к первому полю, а не к началу карточки. *@
<section class="section apply">
    <div class="container">
        @* Заголовок секции — над карточкой, как у остальных блоков (владелец,
           25.08.2026): раньше он жил внутри карточки, и форма начиналась без
           «белой шапки». Тексты те же (ветка Custom подменяет их так же, как
           раньше внутри компонента), поэтому в карточке заголовка больше нет.
           После отправки шапку не показываем: там уже карточка «спасибо»
           со своим заголовком. *@
        @if (!Sent)
        {
            <div class="section-head apply-head">
                @* Кикер «Без предоплаты» (FormKicker) убран владельцем 25.08.2026;
                   у ветки Custom он осмысленный («Индивидуальный тур») и остаётся. *@
                @if (CustomTour)
                {
                    <span class="apply-kicker">@L["FormCustomKicker"]</span>
                }
                <h2>@L[CustomTour ? "FormCustomTitle" : "FormTitle"]</h2>
                <p>@L[CustomTour ? "FormCustomText" : "FormText"]</p>
            </div>
        }
        @* Блок гида временно убран (21.08.2026): его фото теперь работает лицом
           плавающей кнопки связи в углу, и второй раз перед формой не нужно.
           Разметка, стили .guide-note и ключи GuideTitle/GuideText сохранены —
           блок вернётся, если владелец захочет его обратно.
        <div class="guide-note">
            <span class="guide-ring">
                <img class="guide-photo" src="/img/guide.webp" alt="@L["GuideTitle"]" width="128" height="128" />
            </span>
            <div>
                <strong>@L["GuideTitle"]</strong>
                <p>@L["GuideText"]</p>
            </div>
        </div>
        *@
        <div class="apply-card">
            <ApplicationForm Sent="Sent" Custom="CustomTour" />
        </div>
    </div>
</section>

<section class="section why" id="why">
    <div class="container">
        <div class="section-head">
            <h2>@L["WhyTitle"]</h2>
        </div>
        @* Четвёртый довод — про гида за рулём (владелец, 26.08.2026); на десктопе
           пункты идут 2×2, чтобы справа не оставалась дыра, как было бы при
           трёх колонках. Дублей с «что включено» по-прежнему нет. *@
        <ul class="why-grid">
            @foreach (var i in Enumerable.Range(1, 4))
            {
                <li>
                    <strong>@L[$"Why{i}Title"]</strong>
                    <span>@L[$"Why{i}Text"]</span>
                </li>
            }
        </ul>
    </div>
</section>

@* Блок «Териберка в разное время года» убран владельцем 25.08.2026 вместе со
   второй параллакс-полосой (Band2Text): без сезонов две полосы шли бы подряд.
   Ключи Season*/SeasonNote/Band2Text и стили .seasons-grid/.season-card в проекте
   остались — блок возвращается разметкой. *@

<section class="section practical" id="practical">
    <div class="container">
        <div class="section-head">
            <h2>@L["PracticalTitle"]</h2>
            <p>@L["PracticalSubtitle"]</p>
        </div>
        <div class="faq-list">
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <details>
                    <summary>@L[$"Faq{i}Question"]</summary>
                    <p>@L[$"Faq{i}Answer"]</p>
                </details>
            }
        </div>
    </div>
</section>

@* Отзывы возвращены владельцем 28.08.2026 (убирались как вымышленный контент)
   и стоят после «Что важно знать» (владелец, 28.08.2026) — последний довод перед
   финальным призывом. Состав — без китайских гостей (владелец, 28.08.2026):
   шесть карточек из сохранённых ключей Review1..9, список — Reviews в @@code
   (id ключа + звёзды). Тексты — черновики до замены на настоящие отзывы.
   Лента — тот же .carousel-wrap, что у мест: свайп на scroll-snap без JS,
   стрелки от carousel.js; автопрокрута сознательно нет — отзыв читают дольше,
   чем смотрят фото. Фото гостей владелец пришлёт позже: файл
   wwwroot/img/reviews/review-{id}.webp (id — номер ключа Review{id}, не позиция
   в ленте) подхватится сам (проверка File.Exists, как было у слайдов полосы
   «Что вас ждёт»), пока его нет — кружок-инициал. *@
<section class="section reviews" id="reviews">
    <div class="container">
        <div class="section-head">
            <h2>@L["ReviewsTitle"]</h2>
            <p>@L["ReviewsSubtitle"]</p>
        </div>
        <div class="carousel-wrap">
            <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
            <div class="reviews-carousel carousel-track">
                @foreach (var (id, stars, date) in Reviews)
                {
                    <article class="review-card">
                        <div class="review-head">
                            @if (ReviewPhotoExists(id))
                            {
                                <span class="review-avatar">
                                    <img src="@Asset($"/img/reviews/review-{id}.webp")" alt="@L[$"Review{id}Name"]" loading="lazy" decoding="async" />
                                </span>
                            }
                            else
                            {
                                <span class="review-avatar" aria-hidden="true">@L[$"Review{id}Name"].Value[..1]</span>
                            }
                            <span class="review-person">
                                <span class="review-name">@L[$"Review{id}Name"]</span>
                                <span class="review-from">@L[$"Review{id}From"]</span>
                            </span>
                            <span class="review-meta">
                                <span class="review-stars" role="img" aria-label="@(stars)/5">@(new string('★', stars))@(new string('☆', 5 - stars))</span>
                                <span class="review-date">@date.ToString("y")</span>
                            </span>
                        </div>
                        <blockquote>@L[$"Review{id}Text"]</blockquote>
                    </article>
                }
            </div>
            <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
        </div>
        @* Фотолента гостей (владелец, 28.08.2026): реальные кадры туристов из
           поездок под карточками отзывов (16.09.2026 — сначала отзывы, потом фото; раньше лента стояла над ними). Файлы — wwwroot/img/guests/guest-*.webp
           (кроп 3:4 из оригиналов владельца, convert-photos.py); лента рендерит
           то, что лежит в каталоге: нет файлов — нет ленты, новый кадр = новый
           файл, без правки кода (адрес с отпечатком выдаёт MapStaticAssets, поэтому
           кадр должен попасть в сборку). Клик — лайтбокс (fallback
           без JS — файл в новой вкладке), кадры-«полароиды» с лёгким разворотом. *@
        @* На мобиле — по одному кадру во всю ширину со стрелками carousel.js
           (владелец, 28.08.2026: край соседнего кадра читался как обрез — та же
           претензия, что была к ленте мест), на десктопе стрелки скрыты, ряд
           с переносом. *@
        @{ var guests = GuestPhotos(); }
        @if (guests.Count > 0)
        {
            <div class="guests-carousel carousel-wrap">
                <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
                <ul class="guests-row carousel-track">
                    @foreach (var file in guests)
                    {
                        <li class="guest-shot">
                            <a class="lightbox-link" href="@Asset($"/img/guests/{file}")" target="_blank" rel="noopener">
                                <img src="@Asset($"/img/guests/{file}")" srcset="@SrcSet($"/img/guests/{file}", 900)"
                                     sizes="@GuestSizes" alt="@L["GuestsAlt"]" loading="lazy" decoding="async" />
                            </a>
                        </li>
                    }
                </ul>
                <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
            </div>
        }
    </div>
</section>

@* Блок «Нужен индивидуальный тур?» убран владельцем 25.08.2026: индивидуальный
   маршрут теперь один из вариантов в самой форме, и отдельный призыв в конце
   страницы дублировал его. Ветка Custom (?tour=custom) жива — меняет кикер,
   заголовок и подводку над формой, — но ссылок на неё со страницы больше нет;
   стили .custom-tour и ключи CustomTour* сохранены. *@

@* Финальный призыв после FAQ (владелец, 25.08.2026): дочитавшему хвост страницы
   было некуда нажать — за FAQ сразу начиналась морская зона с футером. Якорь #apply
   скроллит вверх, к форме: это осознанно, форма на странице одна. Оформление —
   от убранного блока «Индивидуальный тур» (.custom-tour), кикера у него нет. *@
<section class="custom-tour" id="final-cta">
    <img class="home-final-photo" src="@Asset("/img/itinerary/return-sunset.webp")" srcset="@SrcSet("/img/itinerary/return-sunset.webp", 960)"
         sizes="@SeaPhotoSizes" alt="" width="960" height="600" loading="lazy" decoding="async" />
    <div class="container">
        <h2>@L["FinalCtaTitle"]</h2>
        @* Фраза собирается из кусков, а не из одного ключа с разметкой: внутри две
           ссылки — на бота и на чат, — а порядок слов в трёх языках разный, поэтому
           каждый язык даёт свои связки (тот же приём, что у согласия в форме).
           «Прямо отсюда» — ссылка в чат: класс contact-chat тот же, что у пункта
           виджета связи, поэтому chat.js открывает панель на месте, а без JavaScript
           страница перезагрузится с ?chat=open (блок живёт только на главной —
           отсюда путь "/"). Ссылка на бота рендерится только при заданном TG_BOT_URL. *@
        <p class="final-cta-lead">
            @L["FinalCtaLead"]@if (!string.IsNullOrWhiteSpace(BotUrl))
            {<text>@L["FinalCtaBotPrefix"]</text><a href="@BotUrl" target="_blank" rel="noopener">@L["FinalCtaBot"]</a>}@L["FinalCtaOr"]<a class="contact-chat" href="@ChatPaths.WithOpen("/")">@L["FinalCtaHere"]</a>.
        </p>
        <a class="btn btn-pulse" href="#apply">@L["HeroCta"]</a>
    </div>
</section>

</div>

<script src="@Assets["js/night-sky.js"]" defer></script>

@* Разметка schema.org: FAQ из блока «Практично» и минимальный WebSite.
   Контакты и логотип сознательно не указываем: в футере плейсхолдеры,
   а логотип у schema.org должен быть растровым (см. чек-лист в CLAUDE.md). *@
<JsonLd Data="FaqLd" />
@if (Seo.HasSiteUrl)
{
    <JsonLd Data="SiteLd" />
}

@code {
    // Компактная подборка для первого экрана; alt-тексты берём из общего каталога.
    // Остальные кадры загружаются лениво, первый остаётся приоритетным для LCP.
    private static readonly HeroSlides.Slide[] IntroSlides = new[]
    {
        "hero-bay.webp", "hero-vessel.webp", "hero-winter-bay.webp", "hero-fireweed.webp",
        "hero-edge.webp", "hero-ships.webp", "hero-waterfall.webp", "hero-gorge.webp",
        "hero-winter-surf.webp", "hero-winter-ship.webp", "hero-winter-sun.webp", "hero-wind.webp",
    }.Select(file => HeroSlides.All.Single(slide => slide.FileName == file)).ToArray();

    // Карточки «Что вы увидите». Key — префикс ключей {Key}Title/{Key}Text в resx (у тундры
    // и сияния — ключи самих мест, тексты не дублируются). Photo — кадр шириной 1280px
    // с копиями для srcset. Href — страница места или шаг программы дня: #stop-N — номер
    // остановки в RoutePhotos, переставишь шаги — поправь и здесь.
    private sealed record SeeCard(string Key, string Photo, string Href);

    private static readonly SeeCard[] SeeCards =
    [
        new("See1", "/img/see/ocean-beach.webp", "/place/barents-sea"),
        new("See2", "/img/places/dragon-eggs.webp", "/place/dragon-eggs"),
        new("See3", "/img/places/ship-graveyard.webp", "/place/ship-graveyard"),
        new("See4", "/img/see/sea-trip.webp", "#stop-4"),         // морская прогулка
        new("See5", "/img/see/old-teriberka.webp", "#stop-5"),    // Старая Териберка
        new("Place6", "/img/places/arctic-tundra.webp", "/place/arctic-tundra"),
        new("Place5", "/img/places/northern-lights.webp", "/place/northern-lights"),
    ];

    // Фото остановок маршрута дня, файлы в wwwroot/img/itinerary/ (кадры владельца,
    // конвертация — tools/convert-photos.py --width 1000 --aspect 16:10: рамка
    // карточки 16/10, остальное обрезалось бы CSS, но скачивалось; копии для srcset —
    // tools/image-variants.py --widths 640). Несколько имён = карусель. Имена
    // описательные, без номера шага: перестановка шагов не требует переименований,
    // а новый кадр под новым именем не застревает в 30-дневном кеше картинок.
    // Первый кадр — главный, его alt — название шага.
    private static readonly string[][] RoutePhotos =
    [
        ["meet-lighthouse.webp", "meet-icebreaker.webp", "meet-icebreaker-sunset.webp"], // маяк-мемориал в Мурманске + ледокол «Ленин» + ледокол на закате
        ["road-windfarm-winter.webp", "road-stone-garden.webp", "road-tundra.webp"],     // Кольская ВЭС + каменный сад + тундра
        ["tasting-urchins.webp", "tasting-scallop.webp", "tasting-urchin-hand.webp"],    // ежи и гребешки + гребешок и ёж в руке над водой
        ["sea-helm.webp", "sea-bay.webp", "sea-sunset.webp"],                            // штурвал катера + бухта с воды + закат над морем
        ["old-ship.webp", "old-ship-winter.webp", "old-reindeer.webp", "old-beach.webp"], // корабль на песке летом и зимой + олень + песчаный пляж
        ["lunch-edge-sign.webp", "lunch-edge-bay.webp"],                                 // знак «Край Земли» над посёлком и бухтой
        ["park-dragon-eggs.webp", "park-waterfall.webp", "park-boardwalk.webp"],         // пляж Драконьих яиц + Батарейский водопад + деревянная тропа зимой
        ["return-sunset.webp"],                                                          // зимний закат над сопками
    ];

    // Состав ленты отзывов: id ключа Review{id} в resx + звёзды + месяц поездки.
    // Только гости из России (владелец, 28.08.2026): китайские (Ван Лэй-3,
    // Чжан Вэй-9) и Сара из Лондона (6) не показываются, ключи в resx целы;
    // у Павла (8) город сменён с Минска на Нижний Новгород, у Елены (4) текст
    // переписан — прежний дублировал Дмитрия (драконьи яйца и уха).
    // У Игоря четыре звезды — его текст прямо говорит «звезду снял», одинаковые
    // пятёрки у всех читались бы как накрутка. Даты — черновики, как и тексты:
    // все в текущем 2026 году и в прошлом (владелец, 28.08.2026), подогнаны под
    // сюжет (аврора — только зимой и ранней весной) и разведены по месяцам.
    // Показ — ToString("y"): формат «месяц + год» культуры запроса, resx не нужен.
    private static readonly (int Id, int Stars, DateOnly Date)[] Reviews =
    [
        (2, 5, new(2026, 1, 1)),  // Дмитрий — шторм на Баренцевом, драконьи яйца
        (1, 5, new(2026, 2, 1)),  // Анна — сияние в первую ночь
        (5, 4, new(2026, 3, 1)),  // Игорь — сияние со второй попытки
        (4, 5, new(2026, 4, 1)),  // Елена — семьёй с детьми
        (7, 5, new(2026, 5, 1)),  // Мария — Батарейский водопад в шторм
        (8, 5, new(2026, 7, 1)),  // Павел — день рождения жены, лето
    ];

    // Фото гостя подхватывается по появлению файла review-{id}.webp — без правки
    // разметки (тот же приём File.Exists, что был у слайдов полосы «Что вас ждёт»).
    private bool ReviewPhotoExists(int id) =>
        File.Exists(Path.Combine(Env.WebRootPath, "img", "reviews", $"review-{id}.webp"));

    // Кадры фотоленты гостей: guest-*.webp из wwwroot/img/guests, сортировка по
    // имени (guest-1..guest-9; до десятого кадра строкового порядка достаточно).
    // Скан каталога на рендер — тот же компромисс, что у File.Exists выше: главная
    // и так читает диск на каждый запрос.
    // Уменьшенные копии для srcset (guest-1-w480.webp) — не отдельные кадры, их отсекаем.
    private IReadOnlyList<string> GuestPhotos()
    {
        var dir = Path.Combine(Env.WebRootPath, "img", "guests");
        if (!Directory.Exists(dir)) return [];
        return Directory.GetFiles(dir, "guest-*.webp")
            .Where(f => !VariantName.IsMatch(Path.GetFileNameWithoutExtension(f)))
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .Select(f => Path.GetFileName(f))
            .ToList();
    }

    // Уменьшенные копии фото лежат рядом с кадром: umba.webp → umba-w640.webp, umba-w960.webp.
    // Делает их tools/image-variants.py; ширины в его --widths обязаны быть из этого списка.
    // 800 добавлена 16.09.2026: карточка места на телефоне 372px при 1,75–2x просила
    // 651–744px, и браузер брал ближайший больший кадр — 960 (≈150 КБ); с копией 800
    // тот же экран получает ≈100 КБ (PageSpeed: «изображение больше контейнера»).
    private static readonly int[] SrcSetWidths = [480, 640, 800, 960];
    private static readonly System.Text.RegularExpressions.Regex VariantName = new(@"-w\d+$");

    // srcset из копий кадра: браузер сам берёт файл под ширину карточки и плотность
    // экрана — карточка в 340px больше не качает кадр в 1280px (замер 16.09.2026:
    // 6,4 МБ фото на главной). width — ширина самого файла. Копий нет — null, Blazor
    // атрибут не рендерит, и кадр грузится целиком, как раньше. File.Exists на рендер —
    // тот же компромисс, что у GuestPhotos.
    private string? SrcSet(string path, int width)
    {
        var ext = Path.GetExtension(path);
        var stem = path[..^ext.Length];
        var candidates = SrcSetWidths
            .Where(w => w < width && File.Exists(Path.Combine(Env.WebRootPath, $"{stem.TrimStart('/')}-w{w}{ext}")))
            .Select(w => $"{Asset($"{stem}-w{w}{ext}")} {w}w")
            .ToList();
        return candidates.Count == 0 ? null : string.Join(", ", candidates.Append($"{Asset(path)} {width}w"));
    }

    // Адрес файла из wwwroot с отпечатком содержимого (img/places/umba.<хеш>.webp): его
    // выдаёт MapStaticAssets, кеш у такого адреса вечный, а при замене файла меняется
    // сама ссылка — ручные ?v= больше не нужны (16.09.2026). Файл, неизвестный сборке,
    // Assets не знает — тогда адрес остаётся как есть.
    private string Asset(string path) => Assets[path.TrimStart('/')];

    // sizes из пар «медиаусловие → ширина слота» (последняя пара — без условия).
    // На экранах плотнее 2,5x (телефоны) слот называется в полтора раза меньше:
    // браузер берёт кадр под 2x, а не под 3x — на фото разницы не видно, а весит он
    // вдвое меньше (замер 16.09.2026, профиль iPhone 390px@3x: 4,9 МБ фото без этого
    // пункта, 2,8 МБ с ним). На вёрстку sizes не влияет — ширину img задаёт CSS.
    // Браузер без min-resolution просто пропустит эти пункты и возьмёт кадр под 3x.
    private static string Sizes(params (string? Media, string Slot)[] slots) =>
        string.Join(", ", slots.SelectMany(s => new[]
        {
            $"{(s.Media is null ? "" : s.Media + " and ")}(min-resolution: 2.5dppx) calc(({s.Slot}) / 1.5)",
            $"{(s.Media is null ? "" : s.Media + " ")}calc({s.Slot})",
        }));

    // Слоты повторяют сетки из app.css — промах вёрстку не ломает, но браузер возьмёт
    // не тот файл, поэтому меняешь сетку — правь и здесь. Карточки мест (.places-grid):
    // до 560px карусель по одной во всю ширину контейнера (паддинги 20+20), до 960px
    // две колонки, дальше три (у .cols-2 — две) в контейнере 1080px.
    private static readonly string PlaceSizes3 = Sizes(("(max-width: 559px)", "100vw - 40px"), ("(max-width: 959px)", "50vw - 30px"), (null, "340px"));
    private static readonly string PlaceSizes2 = Sizes(("(max-width: 559px)", "100vw - 40px"), ("(max-width: 959px)", "50vw - 30px"), (null, "510px"));
    private static string PlaceSizes(bool twoCols) => twoCols ? PlaceSizes2 : PlaceSizes3;

    // Сетки home.css: коллаж и карта — две колонки от 960px; фотокарточки —
    // две от 561px. Первый кадр коллажа и миниатюра загружаются без lazy.
    private static readonly string HeroPhotoSizes = Sizes(("(max-width: 699px)", "100vw - 40px"), ("(max-width: 959px)", "660px"), (null, "517px"));
    private static readonly string SeePhotoSizes = Sizes(("(max-width: 560px)", "100vw - 40px"), ("(max-width: 1079px)", "50vw - 30px"), (null, "510px"));
    private static readonly string SeeFeaturedPhotoSizes = Sizes(("(max-width: 1079px)", "100vw - 40px"), (null, "1040px"));
    private static readonly string IncludedPhotoSizes = Sizes(("(max-width: 799px)", "50vw - 26px"), (null, "404px"));
    private static readonly string SeaPhotoSizes = Sizes((null, "100vw"));

    // На телефоне у нити компактные маркеры: 40px контейнера + 36px отступа.
    // От 900px остаётся шахматка — половина контейнера минус 48px.
    private static readonly string RouteSizes = Sizes(("(max-width: 899px)", "100vw - 76px"), (null, "470px"));

    // Фотолента гостей: до 800px кадр во всю ленту (контейнер 40 + паддинги ленты 8
    // и «полароида» 16), дальше .guest-shot 220px минус тот же паддинг.
    private static readonly string GuestSizes = Sizes(("(max-width: 799px)", "100vw - 64px"), (null, "204px"));

    // Сама форма (POST, валидация, редирект) живёт в компоненте ApplicationForm —
    // здесь только флаги из query: показана ли карточка «спасибо» и какая ветка формы.
    [SupplyParameterFromQuery(Name = "sent")]
    public bool Sent { get; set; }

    [SupplyParameterFromQuery(Name = "tour")]
    public string? Tour { get; set; }

    private bool CustomTour => string.Equals(Tour, "custom", StringComparison.OrdinalIgnoreCase);

    // Ссылка на Telegram-бота в финальном призыве: пусто — пункт не рендерится,
    // как в шапке и виджете связи.
    private string? BotUrl => Configuration["TG_BOT_URL"];

    // JSON-LD собирается словарями: ключи "@context"/"@type" невозможны в анонимных
    // типах, а .Value обязателен — LocalizedString сам в строку не сериализуется.
    private IReadOnlyDictionary<string, object?> FaqLd => new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = Enumerable.Range(1, 6).Select(i => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = L[$"Faq{i}Question"].Value,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = L[$"Faq{i}Answer"].Value
            }
        }).ToArray()
    };

    // Шаги программы дня, у которых есть своя страница места (миниатюра-ссылка в карточке шага).
    private IReadOnlyDictionary<string, object?> SiteLd => new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = L["Brand"].Value,
        ["url"] = Seo.Absolute("/")
    };
}
