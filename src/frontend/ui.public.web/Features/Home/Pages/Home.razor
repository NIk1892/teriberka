@page "/"
@using UI.Public.Web.Layouts
@using UI.Public.Web.Features.Places
@using UI.Public.Web.Features.Seo
@using UI.Public.Web.Components
@using Microsoft.Extensions.Localization
@layout MainLayout
@inject IStringLocalizer<SharedResource> L
@inject SeoUrls Seo

<PageTitle>@L["PageTitle"]</PageTitle>
<PageMeta Title="@L["PageTitle"]" Description="@L["MetaDescription"]" Path="/" ImagePath="/img/og.jpg" />

@* Воронка главной: витрина и день в Териберке → кнопка заявки → другие маршруты
   Кольского → аргументы и FAQ → форма в конце (владелец, 25.08.2026). *@

@* data-speed — параллакс-слои effects.js: положительное значение = слой отстаёт
   от прокрутки (читается дальше). Карта отстаёт сильнее текста — глубина как
   в hero andyhardy.co. Без JS атрибут просто игнорируется. *@
<section class="hero" id="directions">
    <div class="container hero-grid">
        <div class="hero-copy" data-speed="0.07">
            <span class="hero-kicker">@L["HeroKicker"]</span>
            <h1>
                @L["HeroTitle"]
                <span class="hero-title-sub">@L["HeroTitleSub"]</span>
            </h1>
            <p class="hero-text">@L["HeroText"]</p>
            <ul class="hero-facts">
                @foreach (var i in Enumerable.Range(1, 4))
                {
                    <li>@L[$"HeroFact{i}"]</li>
                }
            </ul>
        </div>

        <div class="hero-visual" data-speed="0.16">
            <div class="hero-map">
                <KolaMap />
                <p class="map-hint">@L["MapHint"]</p>
            </div>
        </div>

        @* Карточки мест Териберки. id=places — якорь шапки. *@
        <section class="hero-places" id="places">
            <div class="section-head">
                <h2>@L["PlacesTitle"]</h2>
                <p>@L["PlacesSubtitle"]</p>
                @* Карточек шесть, а кадров у владельца больше — отсюда путь в «Галерею»
                   (она же в шапке). Ссылка стоит в шапке блока, а не под карточками
                   (владелец, 25.08.2026): под лентой её замечали уже после того, как
                   пролистали всё. В скобках и мелким — это примечание к блоку, а не
                   его призыв: главное здесь сами места (владелец, 25.08.2026).
                   Скобки — в разметке, а не в ключе: пунктуация одна на все языки.
                   Раздел пока заглушка «скоро». *@
                <p class="places-more">(<a href="/gallery">@L["PlacesGalleryLink"]</a>)</p>
            </div>
            @* На ≤560px сетка становится каруселью по одной карточке во всю ширину
               (владелец, 24.08.2026: «половинка» соседней карточки читалась как обрез);
               стрелки — carousel.js, на широких экранах скрыты, там обычная сетка. *@
            <div class="places-carousel carousel-wrap">
            <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
            <div class="places-grid carousel-track">
                @foreach (var idx in PlaceCatalog.Directions[0].PlaceIndexes)
                {
                    var place = PlaceCatalog.ByIndex(idx);
                    <a class="place-card" href="/place/@place.Slug">
                        <span class="place-photo">
                            <img src="/img/places/@(place.Slug).webp" alt="@L[$"Place{idx}Title"]" loading="lazy" decoding="async" />
                        </span>
                        <span class="place-body">
                            <strong class="place-title">@L[$"Place{idx}Title"]</strong>
                            <span class="place-text">@L[$"Place{idx}Text"]</span>
                            <span class="place-more">@L["PlaceMore"]</span>
                        </span>
                    </a>
                }
            </div>
            <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
            </div>
        </section>
    </div>
</section>

<section class="section itinerary" id="itinerary">
    <div class="container">
        <div class="section-head">
            <h2>@L["ItineraryTitle"]</h2>
            <p>@L["ItinerarySubtitle"]</p>
        </div>
        <ol class="itinerary-list">
            @* Миниатюры мест у шагов были и убраны владельцем 24.08.2026 — программа
               дня остаётся текстовой, фото живут в карточках мест. *@
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <li>
                    <span class="itinerary-num">0@(i)</span>
                    <div>
                        <strong>@L[$"Itinerary{i}Title"]</strong>
                        <p>@L[$"Itinerary{i}Text"]</p>
                    </div>
                </li>
            }
        </ol>
        <p class="itinerary-note">@L["ItineraryNote"]</p>

        @* Кнопка с ценой под программой дня (владелец, 25.08.2026): форма стоит
           в конце страницы, сюда возвращается только призыв. Ghost-кнопки
           «Программа дня» рядом нет — она вела бы в блок, который прямо над ней
           (ключ HeroCta2 в resx остался). До этого места кнопку заявки держит
           шапка: .nav-apply на десктопе и .header-apply на мобиле. *@
        <div class="tour-cta">
            <div class="hero-actions">
                <a class="btn btn-pulse" href="#apply">@L["HeroCta"]</a>
            </div>
            <p class="hero-meta">
                <strong class="hero-price">@L["HeroPrice"]</strong>
                <span class="hero-note">@L["HeroNote"]</span>
                <span class="hero-trust">@L["HeroTrust"]</span>
            </p>
        </div>
    </div>
</section>

<section class="route-picker more-routes" id="more-routes" aria-labelledby="other-routes-title">
    <div class="container">
        <div class="route-picker-head">
            <span>@L["OtherRoutesKicker"]</span>
            <h2 id="other-routes-title">@L["OtherRoutesTitle"]</h2>
            <p>@L["OtherRoutesText"]</p>
        </div>

        @foreach (var dir in PlaceCatalog.Directions.Skip(1))
        {
            <div class="direction-block" id="dir-@dir.Key">
                <div class="direction-head">
                    <span class="direction-num" aria-hidden="true">0@(dir.Index)</span>
                    <div>
                        <span class="alt-route-type">@L[$"OtherRoute{dir.Index}Type"]</span>
                        <h3>@L[$"Dir{dir.Index}Title"]</h3>
                        <p>@L[$"Dir{dir.Index}Text"]</p>
                    </div>
                </div>
                @* меньше трёх карточек — двухколоночная сетка (в трёх колонках пусто), иначе обычные три *@
                <div class="places-carousel carousel-wrap">
                <button class="car-btn car-prev" type="button" aria-label="@L["CarouselPrev"]">‹</button>
                <div class="places-grid carousel-track @(dir.PlaceIndexes.Length < 3 ? "cols-2" : "")">
                    @foreach (var idx in dir.PlaceIndexes)
                    {
                        var place = PlaceCatalog.ByIndex(idx);
                        <a class="place-card" href="/place/@place.Slug">
                            <span class="place-photo">
                                <img src="/img/places/@(place.Slug).webp" alt="@L[$"Place{idx}Title"]" loading="lazy" decoding="async" />
                            </span>
                            <span class="place-body">
                                <strong class="place-title">@L[$"Place{idx}Title"]</strong>
                                <span class="place-text">@L[$"Place{idx}Text"]</span>
                                <span class="place-more">@L["PlaceMore"]</span>
                            </span>
                        </a>
                    }
                </div>
                <button class="car-btn car-next" type="button" aria-label="@L["CarouselNext"]">›</button>
                </div>
            </div>
        }

    </div>
</section>


<section class="section why" id="why">
    <div class="container">
        <div class="section-head">
            <h2>@L["WhyTitle"]</h2>
        </div>
        <ul class="why-grid">
            @foreach (var i in Enumerable.Range(1, 3))
            {
                <li>
                    <strong>@L[$"Why{i}Title"]</strong>
                    <span>@L[$"Why{i}Text"]</span>
                </li>
            }
        </ul>
    </div>
</section>

<section class="section" id="included">
    <div class="container">
        <div class="section-head">
            <h2>@L["IncludedTitle"]</h2>
            <p>@L["IncludedSubtitle"]</p>
        </div>
        <ul class="included-grid">
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <li>@L[$"Included{i}"]</li>
            }
        </ul>
    </div>
</section>

@* Параллакс: в современных браузерах — многослойная сцена (небо fixed, две гряды сопок
   и текст едут с разной скоростью через CSS scroll-driven animations), фоллбек — цельный
   fixed-пейзаж. Всё без JavaScript, см. блок «параллакс-полосы» в app.css. *@
<div class="parallax-band">
    <div class="parallax-mist" aria-hidden="true"></div>
    <div class="container">
        <p>@L["Band1Text"]</p>
    </div>
</div>

<section class="section seasons" id="seasons">
    <div class="container">
        <div class="section-head">
            <h2>@L["SeasonsTitle"]</h2>
            <p>@L["SeasonsSubtitle"]</p>
        </div>
        <div class="seasons-grid">
            @foreach (var i in Enumerable.Range(1, 3))
            {
                <article class="season-card">
                    <h3>@L[$"Season{i}Title"]</h3>
                    <p>@L[$"Season{i}Text"]</p>
                </article>
            }
        </div>
        <p class="season-note">@L["SeasonNote"]</p>
    </div>
</section>

<div class="parallax-band band-2">
    <div class="parallax-mist" aria-hidden="true"></div>
    <div class="container">
        <p>@L["Band2Text"]</p>
    </div>
</div>

<section class="section practical" id="practical">
    <div class="container">
        <div class="section-head">
            <h2>@L["PracticalTitle"]</h2>
            <p>@L["PracticalSubtitle"]</p>
        </div>
        <div class="faq-list">
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <details>
                    <summary>@L[$"Faq{i}Question"]</summary>
                    <p>@L[$"Faq{i}Answer"]</p>
                </details>
            }
        </div>
    </div>
</section>

@* Форма — в конце страницы, после того как сняты возражения (что включено,
   сезоны, FAQ). Под программой дня стоит только кнопка-якорь: пробовали ставить
   сюда саму форму (25.08.2026), владелец вернул кнопку. Форма на странице ровно
   одна — у static SSR FormName уникален, двух ApplicationForm быть не может.
   id="apply" — внутри, на самой форме (ApplicationForm.razor): якорь должен
   приводить к первому полю, а не к началу карточки. *@
<section class="section apply">
    <div class="container">
        @* Блок гида временно убран (21.08.2026): его фото теперь работает лицом
           плавающей кнопки связи в углу, и второй раз перед формой не нужно.
           Разметка, стили .guide-note и ключи GuideTitle/GuideText сохранены —
           блок вернётся, если владелец захочет его обратно.
        <div class="guide-note">
            <span class="guide-ring">
                <img class="guide-photo" src="/img/guide.webp" alt="@L["GuideTitle"]" width="128" height="128" />
            </span>
            <div>
                <strong>@L["GuideTitle"]</strong>
                <p>@L["GuideText"]</p>
            </div>
        </div>
        *@
        <div class="apply-card">
            <ApplicationForm Sent="Sent" Custom="CustomTour" />
        </div>
    </div>
</section>

@* Индивидуальный тур: последний конверсионный блок — CTA открывает ту же форму
   в ветке Custom (?tour=custom): другие кикер, заголовок и подводка. *@
<section class="custom-tour" id="custom-tour">
    <div class="container">
        <span class="custom-tour-kicker">@L["CustomTourKicker"]</span>
        <h2>@L["CustomTourTitle"]</h2>
        <p>@L["CustomTourText"]</p>
        <a class="btn" href="/?tour=custom#apply">@L["CustomTourCta"]</a>
    </div>
</section>

@* Разметка schema.org: FAQ из блока «Практично» и минимальный WebSite.
   Контакты и логотип сознательно не указываем: в футере плейсхолдеры,
   а логотип у schema.org должен быть растровым (см. чек-лист в CLAUDE.md). *@
<JsonLd Data="FaqLd" />
@if (Seo.HasSiteUrl)
{
    <JsonLd Data="SiteLd" />
}

@code {
    // Сама форма (POST, валидация, редирект) живёт в компоненте ApplicationForm —
    // здесь только флаги из query: показана ли карточка «спасибо» и какая ветка формы.
    [SupplyParameterFromQuery(Name = "sent")]
    public bool Sent { get; set; }

    [SupplyParameterFromQuery(Name = "tour")]
    public string? Tour { get; set; }

    private bool CustomTour => string.Equals(Tour, "custom", StringComparison.OrdinalIgnoreCase);

    // JSON-LD собирается словарями: ключи "@context"/"@type" невозможны в анонимных
    // типах, а .Value обязателен — LocalizedString сам в строку не сериализуется.
    private IReadOnlyDictionary<string, object?> FaqLd => new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = Enumerable.Range(1, 6).Select(i => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = L[$"Faq{i}Question"].Value,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = L[$"Faq{i}Answer"].Value
            }
        }).ToArray()
    };

    // Шаги программы дня, у которых есть своя страница места (миниатюра-ссылка в карточке шага).
    private IReadOnlyDictionary<string, object?> SiteLd => new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = L["Brand"].Value,
        ["url"] = Seo.Absolute("/")
    };
}
