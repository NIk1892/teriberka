@page "/"
@using UI.Public.Web.Layouts
@using UI.Public.Web.Features.Places
@using global::Applications.Contracts
@using FluentValidation
@using Microsoft.Extensions.Localization
@layout MainLayout
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IEnumerable<IValidator<ApplicationCreateCommand>> Validators
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PageTitle"]</PageTitle>

<section class="hero" id="directions">
    <span class="shooting-star" aria-hidden="true"></span>
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="hero-kicker">@L["HeroKicker"]</span>
            <h1>
                @L["HeroTitle"]
                <span class="hero-title-sub">@L["HeroTitleSub"]</span>
            </h1>
            <p class="hero-text">@L["HeroText"]</p>
            <p class="hero-text hero-text-accent">@L["HeroText2"]</p>
            <div class="hero-actions">
                <a class="btn btn-pulse" href="#apply">@L["HeroCta"]</a>
                <span class="hero-price">@L["HeroPrice"]</span>
                <span class="hero-note">@L["HeroNote"]</span>
            </div>
        </div>

        <div class="hero-map">
            <KolaMap />
            <p class="map-hint">@L["MapHint"]</p>
        </div>
    </div>

    <div class="container">
        <dl class="hero-stats">
            @foreach (var i in Enumerable.Range(1, 3))
            {
                <div class="stat">
                    <dt>@L[$"Stat{i}Num"]</dt>
                    <dd>@L[$"Stat{i}Label"]</dd>
                </div>
            }
        </dl>
    </div>
</section>

<section class="section why" id="why">
    <div class="container">
        <div class="section-head">
            <h2>@L["WhyTitle"]</h2>
        </div>
        <ul class="why-grid">
            @foreach (var i in Enumerable.Range(1, 5))
            {
                <li>
                    <strong>@L[$"Why{i}Title"]</strong>
                    <span>@L[$"Why{i}Text"]</span>
                </li>
            }
        </ul>
    </div>
</section>

<section class="section" id="places">
    <div class="container">
        <div class="section-head">
            <h2>@L["PlacesTitle"]</h2>
            <p>@L["PlacesSubtitle"]</p>
        </div>

        @foreach (var dir in PlaceCatalog.Directions)
        {
            <div class="direction-block" id="dir-@dir.Key">
                <div class="direction-head">
                    <span class="direction-num" aria-hidden="true">0@(dir.Index)</span>
                    <div>
                        <h3>@L[$"Dir{dir.Index}Title"]</h3>
                        <p>@L[$"Dir{dir.Index}Text"]</p>
                    </div>
                </div>
                <div class="places-grid @(dir.PlaceIndexes.Length % 3 != 0 ? "cols-2" : "")">
                    @foreach (var idx in dir.PlaceIndexes)
                    {
                        var place = PlaceCatalog.ByIndex(idx);
                        <a class="place-card" href="/place/@place.Slug">
                            <span class="place-photo">
                                <img src="/img/placeholder.svg" alt="@L["PhotoAlt"]" loading="lazy" />
                                <span class="photo-soon">@L["PhotoSoon"]</span>
                            </span>
                            <span class="place-body">
                                <strong class="place-title">@L[$"Place{idx}Title"]</strong>
                                <span class="place-text">@L[$"Place{idx}Text"]</span>
                                <span class="place-more">@L["PlaceMore"]</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

@* Параллакс: фон полосы закреплён relative to viewport (background-attachment: fixed),
   поэтому при прокрутке пейзаж «стоит», а контент едет поверх. Работает без JavaScript. *@
<div class="parallax-band">
    <div class="container">
        <p>@L["Band1Text"]</p>
    </div>
</div>

<section class="section" id="included">
    <div class="container">
        <div class="section-head">
            <h2>@L["IncludedTitle"]</h2>
            <p>@L["IncludedSubtitle"]</p>
        </div>
        <ul class="included-grid">
            @foreach (var i in Enumerable.Range(1, 6))
            {
                <li>@L[$"Included{i}"]</li>
            }
        </ul>
    </div>
</section>

<section class="section guides" id="guides">
    <div class="container">
        <div class="section-head">
            <h2>@L["GuidesTitle"]</h2>
            <p>@L["GuidesSubtitle"]</p>
        </div>
        <div class="guides-grid">
            @foreach (var i in Enumerable.Range(1, 2))
            {
                var name = L[$"Guide{i}Name"].Value;
                <article class="guide-card">
                    <span class="guide-avatar" aria-hidden="true">@Initials(name)</span>
                    <h3>@name</h3>
                    <span class="guide-role">@L[$"Guide{i}Role"]</span>
                    <p>@L[$"Guide{i}Text"]</p>
                    <span class="guide-fact">@L[$"Guide{i}Fact"]</span>
                </article>
            }
        </div>
    </div>
</section>

<div class="parallax-band band-2">
    <div class="container">
        <p>@L["Band2Text"]</p>
    </div>
</div>

<section class="section reviews" id="reviews">
    <div class="container">
        <div class="section-head">
            <h2>@L["ReviewsTitle"]</h2>
        </div>
        @* Карусель на scroll-snap: свайп на таче, колесо/тачпад на десктопе.
           Стрелки добавляет carousel.js — без него карусель полностью рабочая. *@
        <div class="carousel-wrap">
            <button type="button" class="car-btn car-prev" aria-label="@L["CarouselPrev"]">←</button>
            <button type="button" class="car-btn car-next" aria-label="@L["CarouselNext"]">→</button>
        <div class="reviews-carousel">
            @foreach (var i in Enumerable.Range(1, 9))
            {
                var name = L[$"Review{i}Name"].Value;
                <article class="review-card">
                    <div class="review-head">
                        <span class="review-avatar" aria-hidden="true">@name[..1]</span>
                        <div>
                            <div class="review-name">@name</div>
                            <div class="review-from">@L[$"Review{i}From"]</div>
                        </div>
                    </div>
                    <div class="review-stars" aria-hidden="true">@Stars(Ratings[i - 1])</div>
                    <blockquote>@L[$"Review{i}Text"]</blockquote>
                </article>
            }
        </div>
        </div>
    </div>
</section>

<section class="section apply" id="apply">
    <div class="container">
        <div class="apply-card">
            @if (Sent)
            {
                <div class="sent-card">
                    <span class="sent-icon" aria-hidden="true">✓</span>
                    <h2>@L["SentTitle"]</h2>
                    <p>@L["SentText"]</p>
                    <a href="/">@L["SentAgain"]</a>
                </div>
            }
            else
            {
                <h2>@L["FormTitle"]</h2>
                <p class="apply-lead">@L["FormText"]</p>

                @if (_errors.Length > 0)
                {
                    <ul class="form-errors">
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }

                <EditForm class="form-grid" Model="Model" FormName="application" OnValidSubmit="SubmitAsync">
                    <label class="field">
                        <span>@L["FieldName"]</span>
                        <InputText @bind-Value="Model.Title" required maxlength="255" autocomplete="name" />
                    </label>
                    <label class="field">
                        <span>@L["FieldPhone"]</span>
                        <InputText type="tel" @bind-Value="Model.Phone" required maxlength="32"
                                   placeholder="+7 900 000-00-00" autocomplete="tel" />
                    </label>
                    <label class="field">
                        <span>@L["FieldPeople"]</span>
                        <InputNumber @bind-Value="Model.PeopleCount" required min="1" max="50" />
                    </label>
                    <label class="field">
                        <span>@L["FieldDate"]</span>
                        <InputDate @bind-Value="Model.ArrivalDate" required min="@Today.ToString("yyyy-MM-dd")" />
                    </label>
                    <div class="form-submit">
                        <button class="btn" type="submit">@L["Submit"]</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    // Форма работает на static SSR (обычный POST), поэтому JavaScript в браузере не нужен:
    // значения приезжают в Model через [SupplyParameterFromForm], ответ — редирект по схеме
    // post-redirect-get, чтобы F5 на странице «спасибо» не отправлял заявку повторно.
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    // Оценки отзывов Review1..Review9 (у пятого — четвёрка, «звезду снял за дорогу»).
    private static readonly int[] Ratings = [5, 5, 5, 5, 4, 5, 5, 5, 5];

    private static string Stars(int rating) => new string('★', rating) + new string('☆', 5 - rating);

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? $"{parts[0][..1]}{parts[1][..1]}" : name[..1];
    }

    [SupplyParameterFromForm]
    public ApplicationCreateCommand Model { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "sent")]
    public bool Sent { get; set; }

    private string[] _errors = [];

    protected override void OnInitialized() =>
        Model ??= new ApplicationCreateCommand
        {
            PeopleCount = 2,
            ArrivalDate = Today.AddDays(7)
        };

    private async Task SubmitAsync()
    {
        _errors = Validators
            .Select(validator => validator.Validate(Model))
            .SelectMany(result => result.Errors)
            .Select(failure => failure.ErrorMessage)
            .ToArray();

        if (_errors.Length > 0)
            return;

        try
        {
            await Mediator.Send(Model);
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
            return;
        }

        // именно "true": биндинг bool из query не понимает "1"
        Navigation.NavigateTo("/?sent=true");
    }
}
