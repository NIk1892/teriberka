@using global::Applications.Contracts
@using FluentValidation
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IEnumerable<IValidator<ApplicationCreateCommand>> Validators
@inject IStringLocalizer<SharedResource> L
@inject IConfiguration Configuration

@* Единственная форма заявки на сайте: имя (необязательно) и телефон — всё остальное
   уточняется по телефону. Ветка Custom (открывается ссылкой /?tour=custom#apply)
   меняет только тексты; POST, FormName и обработка общие, отдельной формы для
   индивидуального тура сознательно нет. Работает на static SSR: значения приезжают
   через [SupplyParameterFromForm], после успеха — редирект (post-redirect-get).
   Клиентская валидация — form-ui.js (novalidate + подсказки под полями);
   без JavaScript работают HTML5-атрибуты и серверная проверка. *@

@if (Sent)
{
    @* тот же id, что у формы: ссылка «Записаться» не должна вести в пустоту,
       когда вместо формы показана карточка «спасибо» *@
    <div class="sent-card" id="apply">
        <span class="sent-icon" aria-hidden="true">✓</span>
        <h2>@L["SentTitle"]</h2>
        <p>@L["SentText"]</p>
        <a href="/">@L["SentAgain"]</a>
    </div>
}
else
{
    <span class="apply-kicker">@L[Custom ? "FormCustomKicker" : "FormKicker"]</span>
    <h2>@L[Custom ? "FormCustomTitle" : "FormTitle"]</h2>
    <p class="apply-lead">@L[Custom ? "FormCustomText" : "FormText"]</p>
    <ul class="apply-points">
        <li>@L["FormPoint1"]</li>
        <li>@L["FormPoint2"]</li>
        <li>@L["FormPoint3"]</li>
    </ul>

    @if (!string.IsNullOrEmpty(_generalError))
    {
        <p class="form-errors" role="alert">@_generalError</p>
    }

    @* id="apply" висит на самой форме, а не на секции: ссылки «Записаться» должны
       приводить к первому полю, а не к шапке карточки с фото и подводкой. *@
    <EditForm id="apply" class="form-grid apply-form" Model="Model" FormName="application"
              OnValidSubmit="SubmitAsync"
              data-val-phone="@L["ValPhone"]"
              data-val-consent="@L["ValConsent"]">
        <label class="field @FieldClass("Title")" data-field="Title">
            <span class="field-label">@L["FieldName"]</span>
            <InputText @bind-Value="Model.Title" maxlength="255" autocomplete="name"
                       placeholder="@L["FieldNameHint"]"
                       aria-invalid="@HasError("Title")" />
            @FieldHint("Title")
        </label>
        <label class="field @FieldClass("Phone")" data-field="Phone">
            <span class="field-label">@L["FieldPhone"]<span class="field-required" aria-hidden="true">*</span></span>
            <InputText type="tel" @bind-Value="Model.Phone" maxlength="32" required
                       inputmode="tel" autocomplete="tel"
                       placeholder="+7 900 000-00-00"
                       aria-invalid="@HasError("Phone")" />
            @FieldHint("Phone")
        </label>
        @* Направление — карточки-радиокнопки, а не выпадающий список (владелец,
           25.08.2026): у каждого маршрута видно описание, а не одно название.
           Радио, а не select с подсказкой: подменять текст под выбранный пункт
           без JavaScript нельзя, а здесь все описания видны сразу. Названия и
           тексты — общие с картой и блоком направлений (MapSpot{i} / Dir{i}Text),
           поэтому переименование маршрута не трогает форму. Инпуты обычные, не
           InputRadio: static SSR биндит их по атрибуту name, как чекбокс согласия. *@
        <fieldset class="field field-routes @FieldClass("Route")" data-field="Route">
            <legend class="field-label">@L["FieldRoute"]</legend>
            <div class="route-options">
                @foreach (var route in RouteOptions)
                {
                    <label class="route-option">
                        @* Имя поля — с префиксом модели ("Model.Route"): именно так
                           биндер формы ждёт свойства @Model, и так же называет поля
                           сам InputText. Без префикса выбор молча не доезжает. *@
                        <input type="radio" name="@RouteFieldName" value="@route.Code"
                               checked="@(Model.Route == route.Code)" />
                        <span class="route-option-box">
                            <strong class="route-option-title">@L[route.TitleKey]</strong>
                            <span class="route-option-text">@L[route.TextKey]</span>
                        </span>
                    </label>
                }
            </div>
            @FieldHint("Route")
        </fieldset>
        @* Согласие пока только на клиенте: в контракт не входит,
           сервер его не проверяет — плейсхолдер до настоящей политики ПД. *@
        <label class="consent @ConsentClass()" data-field="Consent">
            <input type="checkbox" name="consent" required />
            <span class="consent-text">@L["ConsentLabel"] <a href="/privacy" target="_blank" rel="noopener">@L["ConsentPolicyLink"]</a><span class="field-required" aria-hidden="true">*</span></span>
            @FieldHint("Consent")
        </label>
        <div class="form-submit">
            @* Кнопка со сноской — такая же колонка, как у бота справа: обе
               подписи держатся за свою кнопку, а не плывут по всей форме. *@
            <span class="form-submit-main">
                <button class="btn btn-pulse" type="submit">@L["Submit"]</button>
                @* Что будет дальше: снимает вопрос «когда со мной свяжутся». *@
                <span class="form-submit-note">@L["FormCallbackNote"]</span>
            </span>
            @* Альтернатива форме — тот же Telegram-бот, что в шапке; рендерится только при заданном TG_BOT_URL. *@
            @if (!string.IsNullOrWhiteSpace(BotUrl))
            {
                <span class="form-submit-or" aria-hidden="true">@L["FormOr"]</span>
                <span class="form-submit-alt">
                    <a class="btn-ghost btn-tg" href="@BotUrl" target="_blank" rel="noopener">
                        <svg class="btn-tg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M21.5 3.6 2.9 10.8c-1 .4-1 1.3-.2 1.6l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2 1-.6l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.5ZM17.2 7.7l-8.1 7.4-.3 3.2-1.4-4.5 9.3-5.9c.4-.3.8 0 .5.3Z" fill="currentColor"/>
                        </svg>
                        <span>@L["FormTelegram"]</span>
                    </a>
                    @* Сноска привязана к кнопке бота, а не к форме целиком. *@
                    <span class="btn-tg-note">@L["FormTelegramNote"]</span>
                </span>
            }
        </div>
    </EditForm>
}

@code {
    /// <summary>Показывать карточку «спасибо» вместо формы (после редиректа ?sent=true).</summary>
    [Parameter] public bool Sent { get; set; }

    /// <summary>Ветка индивидуального тура: другие кикер, заголовок и подводка.</summary>
    [Parameter] public bool Custom { get; set; }

    [SupplyParameterFromForm]
    public ApplicationCreateCommand Model { get; set; } = default!;

    private Dictionary<string, string> _fieldErrors = [];
    private string? _generalError;

    private string? BotUrl => Configuration["TG_BOT_URL"];

    /// <summary>Имя поля маршрута в POST — с тем же префиксом, что у InputText.</summary>
    private const string RouteFieldName = $"{nameof(Model)}.{nameof(ApplicationCreateCommand.Route)}";

    /// <summary>Пункты выбора маршрута: код + ключи названия и описания.</summary>
    private static readonly (string Code, string TitleKey, string TextKey)[] RouteOptions =
    [
        (ApplicationRoutes.Teriberka, "MapSpot1", "Dir1Text"),
        (ApplicationRoutes.Lovozero,  "MapSpot2", "Dir2Text"),
        (ApplicationRoutes.Tersky,    "MapSpot3", "Dir3Text"),
        (ApplicationRoutes.Custom,    "RouteCustomTitle", "RouteCustomText"),
    ];

    // Model приходит из формы только на POST; на GET создаём свою — и в ветке
    // индивидуального тура сразу отмечаем нужный маршрут, чтобы пришедший
    // по ссылке /?tour=custom#apply не выбирал его руками.
    protected override void OnInitialized() =>
        Model ??= new ApplicationCreateCommand
        {
            Route = Custom ? ApplicationRoutes.Custom : ApplicationRoutes.Teriberka
        };

    private async Task SubmitAsync()
    {
        _generalError = null;
        _fieldErrors = Validators
            .SelectMany(validator => validator.Validate(Model).Errors)
            .GroupBy(failure => failure.PropertyName)
            .ToDictionary(group => group.Key, group => group.First().ErrorMessage);

        if (_fieldErrors.Count > 0)
            return;

        try
        {
            await Mediator.Send(Model);
        }
        catch (Exception ex)
        {
            _generalError = ex.Message;
            return;
        }

        // именно "true": биндинг bool из query не понимает "1"
        Navigation.NavigateTo("/?sent=true");
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string FieldClass(string field) => HasError(field) ? "field-invalid" : "";

    private string ConsentClass() => HasError("Consent") ? "field-invalid" : "";

    private RenderFragment FieldHint(string field) => builder =>
    {
        if (!_fieldErrors.TryGetValue(field, out var message))
            return;

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "field-hint field-hint-error");
        builder.AddAttribute(2, "role", "alert");
        builder.AddContent(3, message);
        builder.CloseElement();
    };
}
