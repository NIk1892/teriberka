@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<header class="site-header">
    <div class="container">
        <a class="brand" href="/">
            <img class="brand-mark" src="/favicon.svg" alt="" />
            @L["Brand"]
        </a>

        @* Быстрые переходы к разделам главной (ссылки с "/" работают и со страниц мест).
           На десктопе — строка ссылок, на узких экранах вместо неё бургер ниже. *@
        <nav class="main-nav" aria-label="@L["MenuLabel"]">
            <a href="/#itinerary">@L["NavItinerary"]</a>
            <a href="/#places">@L["NavPlaces"]</a>
            <a href="/#seasons">@L["NavSeasons"]</a>
            <a href="/#practical">@L["NavPractical"]</a>
            <a class="nav-apply" href="/#apply">@L["NavApply"]</a>
        </nav>

        <div class="header-controls">
            @* Ссылка на Telegram-бота появляется, только когда задан TG_BOT_URL. *@
            @if (!string.IsNullOrWhiteSpace(BotUrl))
            {
                <a class="bot-link" href="@BotUrl" rel="noopener" title="@L["BotLink"]" aria-label="@L["BotLink"]">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M21.7 3.3c.3-1.1-.8-2-1.9-1.6L2.7 8.3c-1.2.4-1.2 2-.1 2.5l4.4 1.8 1.7 5.5c.3 1 1.6 1.3 2.3.5l2.4-2.5 4.5 3.3c.9.7 2.2.2 2.4-.9l3.4-15.2ZM8.3 11.7l9.2-5.9c.2-.1.4.1.2.3l-7.6 7-.3 3.3-1.5-4.7Z"/>
                    </svg>
                </a>
            }

            @* Переключение темы и языка без JavaScript: ссылки на endpoints,
               которые ставят cookie и возвращают на текущую страницу.
               nofollow — чтобы краулеры не ходили по служебным редиректам
               (в robots.txt эти пути дополнительно закрыты Disallow). *@
            <a class="theme-toggle" href="@ThemeLink()" rel="nofollow" title="@L["ThemeToggle"]" aria-label="@L["ThemeToggle"]">
                @(IsLight ? "☾" : "☀")
            </a>

            <nav class="lang-switch" aria-label="@L["LangLabel"]">
                <a class="@ActiveClass("ru")" href="@CultureLink("ru")" rel="nofollow" hreflang="ru">RU</a>
                <a class="@ActiveClass("en")" href="@CultureLink("en")" rel="nofollow" hreflang="en">EN</a>
                <a class="@ActiveClass("zh")" href="@CultureLink("zh")" rel="nofollow" hreflang="zh">中文</a>
            </nav>

            @* Бургер для узких экранов: нативный details без JavaScript, закрывается
               кликом в любом месте (fixed-оверлей — summary::before). Как и у .map-spot,
               на .nav-burger нельзя вешать transform — сломается оверлей закрытия. *@
            <details class="nav-burger">
                <summary aria-label="@L["MenuLabel"]" title="@L["MenuLabel"]">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </summary>
                <nav class="burger-panel" aria-label="@L["MenuLabel"]">
                    <a href="/#itinerary">@L["NavItinerary"]</a>
                    <a href="/#places">@L["NavPlaces"]</a>
                    <a href="/#more-routes">@L["NavMoreRoutes"]</a>
                    <a href="/#seasons">@L["NavSeasons"]</a>
                    <a href="/#practical">@L["NavPractical"]</a>
                    <a class="burger-apply" href="/#apply">@L["NavApply"]</a>
                    @if (!string.IsNullOrWhiteSpace(BotUrl))
                    {
                        @* дубль ссылки на бота: показывается только там, где иконка скрыта из шапки *@
                        <a class="burger-bot" href="@BotUrl" rel="noopener">@L["BotLink"]</a>
                    }
                </nav>
            </details>
        </div>
    </div>
</header>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? BotUrl => Configuration["TG_BOT_URL"];

    private bool IsLight => HttpContext?.Request.Cookies["theme"] == "light";

    private static string Current => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static string ActiveClass(string culture) => Current == culture ? "active" : "";

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    private string CultureLink(string culture) =>
        $"/set-culture?culture={culture}&redirect={Uri.EscapeDataString(CurrentPath)}";

    private string ThemeLink() =>
        $"/set-theme?theme={(IsLight ? "dark" : "light")}&redirect={Uri.EscapeDataString(CurrentPath)}";
}
