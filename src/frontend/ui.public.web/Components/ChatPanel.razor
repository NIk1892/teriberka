@using System.Globalization
@using Chat.Contracts
@using Domain
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@using UI.Public.Web.Features.Captcha
@using UI.Public.Web.Features.Chat
@inject IStringLocalizer<SharedResource> L
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject ChatSchedule Schedule
@inject SmartCaptchaService Captcha

@* Панель чата с менеджером. Живёт рядом с кнопкой связи и открывается её пунктом.

   Без JavaScript: пункт — обычная ссылка ?chat=open, панель рендерится сервером
   вместе с историей, отправка идёт POST'ом на /chat/send и возвращается сюда же
   (post-redirect-get). С JavaScript chat.js открывает её на месте и опрашивает
   /chat/poll, не перезагружая страницу.

   История подтягивается только когда панель открыта: иначе каждый рендер каждой
   страницы ходил бы в chat-сервис. *@

@{ var online = Schedule.IsOnline(); }

<section class="chat-panel @(IsOpen ? "is-open" : "")" id="chat"
         aria-label="@L["ChatTitle"]" data-after="@LastOrdinal"
         data-error="@L["ChatErrorGeneric"]" data-too-many="@L["ChatErrorTooMany"]"
         data-captcha="@L["CaptchaFailed"]" data-session="@(HasSession ? "true" : "false")">
    <header class="chat-head">
        <div class="chat-heading">
            <span class="chat-title">@L["ChatTitle"]</span>
            <span class="chat-status @(online ? "is-online" : "is-offline")"
                  role="status" aria-live="polite" aria-atomic="true"
                  title="@L["ChatPresenceSchedule"]"
                  data-online="@L["ChatPresenceOnline"]" data-offline="@L["ChatPresenceOffline"]">
                <span class="chat-status-label">@(online ? L["ChatPresenceOnline"] : L["ChatPresenceOffline"])</span>
            </span>
        </div>
        <span class="chat-response-time" data-online="@L["ChatOnline"]" data-offline="@L["ChatOffline"]">
            @(online ? L["ChatOnline"] : L["ChatOffline"])
        </span>
        @* Без JS закрытие — переход по адресу без ?chat; скрипт перехватывает клик. *@
        <a class="chat-close" href="@ChatPaths.Clean(CurrentPath)"
           title="@L["ChatClose"]" aria-label="@L["ChatClose"]">×</a>
    </header>

    @* тексты для chat.js: inline-скрипт запрещён CSP, поэтому строки едут data-атрибутами *@
    <ol class="chat-log" role="log" aria-live="polite" aria-relevant="additions"
        data-you="@L["ChatYou"]" data-guide="@L["ChatGuide"]"
        data-sent="@L["ChatStatusSent"]" data-delivered="@L["ChatStatusDelivered"]">
        @if (_history.Count == 0)
        {
            <li class="chat-empty">@L["ChatEmpty"]</li>
        }
        @foreach (var message in _history)
        {
            @* data-o — номер сообщения: по нему chat.js обновляет статус уже показанного *@
            @if (message.Direction == ChatDirection.Admin)
            {
                <li class="chat-msg from-guide" data-o="@message.Ordinal">
                    <span class="chat-who">@L["ChatGuide"]</span>
                    <span class="chat-text">@message.Text</span>
                </li>
            }
            else
            {
                @* Статус только у сообщений посетителя: «Отправлено», пока бот не отнёс
                   сообщение в Telegram-группу, дальше «✓ Доставлено менеджеру». *@
                <li class="chat-msg from-you @(message.Delivered ? "is-delivered" : "")" data-o="@message.Ordinal">
                    <span class="chat-who">@L["ChatYou"]</span>
                    <span class="chat-text">@message.Text</span>
                    <span class="chat-state">@(message.Delivered ? L["ChatStatusDelivered"] : L["ChatStatusSent"])</span>
                </li>
            }
        }
    </ol>

    @if (_failed)
    {
        <p class="chat-warn" role="alert">@L["ChatErrorGeneric"]</p>
    }
    else if (State == ChatPaths.Error)
    {
        <p class="chat-warn" role="alert">@L["ChatErrorGeneric"]</p>
    }
    else if (State == ChatPaths.Captcha)
    {
        <p class="chat-warn" role="alert">@L["CaptchaFailed"]</p>
    }
    else if (_cookiesOff)
    {
        <p class="chat-warn" role="alert">@L["ChatErrorCookies"]</p>
    }

    <form class="chat-form" method="post" action="/chat/send">
        <AntiforgeryToken />
        <input type="hidden" name="redirect" value="@CurrentPath" />
        @* honeypot: спрятан классом, потому что inline style запрещён CSP *@
        <input class="hp-field" type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="sr-only" for="chat-text">@L["ChatPlaceholder"]</label>
        <textarea id="chat-text" name="text" rows="2" maxlength="@ChatLimits.MaxTextLength" required
                  placeholder="@L["ChatPlaceholder"]"></textarea>
        <button class="chat-send" type="submit" title="@L["ChatSend"]" aria-label="@L["ChatSend"]">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" />
            </svg>
        </button>
    </form>

    @* Невидимая SmartCaptcha первого сообщения (спам 11–18.09.2026, см. /chat/send
       в Program.cs). Слот — только контейнер виджета: chat.js подключает captcha.js, когда
       панель открыли, а диалога ещё нет. Ключи и CSP общие с формой заявки. *@
    @if (Captcha.Enabled)
    {
        <div class="chat-captcha" data-sitekey="@Captcha.ClientKey" data-src="@SmartCaptchaService.WidgetUrl"></div>
    }

    <p class="chat-note">
        @L["ChatConsentPrefix"] <a href="/privacy" target="_blank" rel="noopener">@L["ConsentPolicyLink"]</a>.
        @L["ChatNoPersonal"]
    </p>

    @* Бейдж виджета спрятан (hideShield) — условия SmartCaptcha требуют тогда своего
       уведомления рядом с формой; то же, что под формой заявки. *@
    @if (Captcha.Enabled)
    {
        <p class="chat-note">@L["CaptchaNote"] <a href="@L["CaptchaNoteUrl"]" target="_blank" rel="noopener nofollow">@L["CaptchaNoteLink"]</a></p>
    }

    @* Без JS новые ответы забираются перезагрузкой; chat.js прячет эту ссылку. *@
    <a class="chat-refresh" href="@ChatPaths.WithOpen(CurrentPath)">@L["ChatRefresh"]</a>
</section>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private IReadOnlyCollection<ChatMessageDto> _history = [];
    private bool _failed;
    private bool _cookiesOff;

    /// <summary>Состояние из адреса: open — панель раскрыта, error — отправка не удалась.</summary>
    private string? State => HttpContext?.Request.Query[ChatPaths.Parameter].ToString();

    private bool IsOpen => State is ChatPaths.Open or ChatPaths.Error or ChatPaths.Captcha;

    /// <summary>
    /// Есть cookie диалога — chat.js не просит капчу заранее. Устаревшую cookie
    /// сервер всё равно отобьёт, и скрипт пройдёт капчу по отказу.
    /// </summary>
    private bool HasSession => !string.IsNullOrEmpty(HttpContext?.Request.Cookies[ChatCookie.Name]);

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    /// <summary>Курсор для поллинга: с какого номера просить новые сообщения.</summary>
    private int LastOrdinal => _history.Count > 0 ? _history.Max(message => message.Ordinal) : 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsOpen)
            return;

        var token = HttpContext?.Request.Cookies[ChatCookie.Name];

        if (string.IsNullOrEmpty(token))
        {
            // Панель открыта, но токена нет: либо диалога ещё не было, либо cookie
            // отключены. Предупреждаем только после отправки — до неё это норма.
            _cookiesOff = State == ChatPaths.Error;
            return;
        }

        try
        {
            _history = await Mediator.Send(new ChatMessageListQuery
            {
                Token = token,
                After = 0,
                Limit = ChatLimits.PageSize
            });
        }
        catch (Exception)
        {
            // chat недоступен — панель всё равно должна открыться и дать написать
            _failed = true;
        }
    }
}
