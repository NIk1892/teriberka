@using System.Globalization
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@(Theme == "light" ? "#f2f6fc" : "#0a0f1d")" />
    @* title и SEO-мета (description, canonical, OG) задают <PageTitle> и <PageMeta>
       каждой страницы через HeadOutlet — глобальных дублей здесь быть не должно *@
    <base href="/" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["favicon-32.png"]" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="@Assets["favicon.svg"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["apple-touch-icon.png"]" />
    @* Assets[...] — адрес с отпечатком содержимого (css/app.<хеш>.css), его ставит
       MapStaticAssets при сборке: поменялся файл — поменялась ссылка, кеш на год.
       Ручные ?v=N больше не нужны (16.09.2026) *@
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/winter.css"]" />
    <HeadOutlet />
</head>

<body>
<Routes />
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    // Тема хранится в cookie (ставит /set-theme); по умолчанию — тёмная.
    private string Theme =>
        HttpContext?.Request.Cookies["theme"] == "light" ? "light" : "dark";
}
