@using System.Globalization
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@(Theme == "light" ? "#f2f6fc" : "#0a0f1d")" />
    @* title и SEO-мета (description, canonical, OG) задают <PageTitle> и <PageMeta>
       каждой страницы через HeadOutlet — глобальных дублей здесь быть не должно *@
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    @* v=2 — сброс часового кеша браузеров при правках стилей (fingerprinting нет,
       версию поднимать руками при заметных изменениях, как у js-файлов) *@
    <link rel="stylesheet" href="/css/app.css?v=68" />
    <HeadOutlet />
</head>

<body>
<Routes />
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    // Тема хранится в cookie (ставит /set-theme); по умолчанию — тёмная.
    private string Theme =>
        HttpContext?.Request.Cookies["theme"] == "light" ? "light" : "dark";
}
