{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SwaggerPathFilters": [ "/api/public/", "/api/private/", "/api/admin/" ],
  "SwaggerEndpoints": {
    "users": "http://api-users:8080/swagger/v1/swagger.json"
  },
  "ReverseProxy": {
    "Routes": {
      "users-user": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/admin/user/{**remainder}" }
      },
      "applications-public": {
        "ClusterId": "users",
        "RateLimiterPolicy": "public-form",
        "Match": { "Path": "/api/public/application/{**remainder}" }
      },
      "applications-admin": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/admin/application/{**remainder}" }
      }
    },
    "Clusters": {
      "users": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "default": {
            "Address": "http://api-users:8080"
          }
        }
      }
    }
  }
}
