# Скопировать в .env и заполнить (.env в .gitignore — в репозиторий не попадает).
# Пароли генерировать длинными: `openssl rand -base64 32`.

# --- адрес сайта ---
# Разработка: localhost.
# Прод: домен, например teriberka-kray.ru (можно перечислить через пробел вместе с www).
# TLS включается отдельно, см. CLAUDE.md (certbot + 443-блок в конфиге nginx).
SITE_DOMAIN=localhost
SITE_URL=http://localhost

# --- хранилище медиа (MinIO) ---
MEDIA_BUCKET=media
# Администратор хранилища: под этой учёткой владелец заходит в консоль и льёт фото
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
# Учётка сайта: только чтение и листинг, root-креденшелы в UI класть нельзя
MEDIA_ACCESS_KEY=teriberka-ui
MEDIA_SECRET_KEY=
# Сколько браузер кэширует картинку (30 суток). Правило: новое фото = новое имя
MEDIA_MAX_AGE=2592000

# --- Telegram (необязательно) ---
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
TG_BOT_URL=
MAX_URL=
