# Скопировать в .env и заполнить (.env в .gitignore — в репозиторий не попадает).
# Пароли генерировать длинными: `openssl rand -hex 32`.
#
# Ключи с пометкой «прод» нужны только на боевом сервере: там стек поднимается
# командой `docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d`,
# и без них compose откажется стартовать. Для локальной разработки достаточно
# заполнить пароли хранилища.

# --- адрес сайта ---
# Разработка: localhost.
# Прод: домен. SITE_DOMAIN — это server_name для nginx, несколько имён
# перечисляются ЧЕРЕЗ ПРОБЕЛ (не через запятую). SITE_HOST — канонический адрес,
# на него ведут редиректы с http и с www; ровно одно имя.
SITE_DOMAIN=localhost
SITE_HOST=localhost
SITE_URL=http://localhost

# --- TLS (прод) ---
# Каталог на сервере с двумя файлами: fullchain.pem (сертификат домена, следом
# промежуточный) и privkey.pem. Лежит ВНЕ репозитория — приватный ключ не должен
# попасть в git. Как собрать — docs/deploy.md.
CERT_DIR=/opt/teriberka/certs

# --- секреты сервисов (прод) ---
# Подпись JWT на шлюзе. В Development берётся значение из appsettings.
JWT_KEY=
# Пароль Postgres. Подставляется в строки подключения, поэтому только буквы и
# цифры: символы "=", ";" и кавычки строку подключения ломают (отсюда hex, а не
# base64). Задать ДО первого старта: на уже созданном томе он не применится.
POSTGRES_PASSWORD=

# --- хранилище медиа (MinIO) ---
MEDIA_BUCKET=media
# Администратор хранилища: под этой учёткой владелец заходит в консоль и льёт фото
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
# Учётка сайта: только чтение и листинг, root-креденшелы в UI класть нельзя
MEDIA_ACCESS_KEY=teriberka-ui
MEDIA_SECRET_KEY=
# Сколько браузер кэширует картинку (30 суток). Правило: новое фото = новое имя
MEDIA_MAX_AGE=2592000

# --- контакты ---
# Телефон в футере и в виджете связи; пусто — строка не показывается
CONTACT_PHONE=
# Почта в футере и на /privacy; пусто — строка не показывается
CONTACT_EMAIL=

# --- SmartCaptcha (необязательно) ---
# Невидимая капча на форме заявки. Оба ключа выдаёт консоль Yandex Cloud:
# console.yandex.cloud → SmartCaptcha → создать капчу (тип «Невидимая»,
# домен сайта в списке разрешённых). Пустые ключи = капча выключена целиком.
# ВАЖНО: с включённой капчей заявка отправляется только с работающим JavaScript.
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
# Профиль владельца в MAX; пусто — пункт виджета не показывается
MAX_URL=

# --- страница заявок /manager ---
# Один общий пароль менеджеров: случайные латинские буквы и цифры, от 8 символов
# (`openssl rand -hex 8`); без $, # и кавычек — в .env они ломаются. Пусто —
# страницы нет вовсе. Сменили пароль — все открытые сессии разлогинятся сами.
MANAGER_PASSWORD=
# Служебный JWT, с которым сайт читает и отмечает заявки через шлюз. Выпускается
# ключом и issuer работающего шлюза (docs/deploy.md, «Страница заявок»).
API_TOKEN=

# --- аналитика ---
# Номер счётчика Яндекс.Метрики (metrika.yandex.ru). Пусто = счётчика на сайте
# нет вовсе: ни скрипта, ни хостов Метрики в CSP. На проде номер уже прописан
# дефолтом в docker-compose.prod.yml, здесь ключ нужен, только чтобы посчитать
# визиты на локальном стеке или временно подменить счётчик.
YANDEX_METRIKA_ID=

# --- Telegram (необязательно) ---
# Без токена бот выключен: чат сохраняет переписку в БД, но в группу гидов ничего
# не уходит. TG_BOT_URL пустым оставить — дефолт базового compose уже ведёт на
# настоящего бота (пустая строка здесь его не перекрывает).
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
TG_BOT_URL=
# Приватный канал менеджеров для отбивок о новых заявках (сервис users). Id узнаётся
# так же, как у группы: добавить бота админом канала и найти в логе chat строку
# «Бота добавили в чат …». Пусто — заявки в Telegram не уходят.
TG_APPLICATIONS_CHAT_ID=
# Прокси для вызовов Telegram (users и chat). С боевого сервера в России Telegram
# напрямую не отвечает — там socks5://tg-proxy:1080, туннель описан в docs/deploy.md.
# Локально пусто — прямое соединение.
TG_PROXY_URL=
